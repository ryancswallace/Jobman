{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobman.tech/schema/protocol/desired-action-v1alpha1.schema.json",
  "title": "Jobman desired action v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jobman/v1alpha1"},
    "kind": {"const": "DesiredAction"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "executionId", "agentId", "revision", "requestedAt"],
      "properties": {
        "actionId": {"$ref": "#/$defs/id"},
        "executionId": {"$ref": "#/$defs/id"},
        "agentId": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "cancel"}}
    }
  },
  "$defs": {"id": {"type": "string", "format": "uuid"}}
}
