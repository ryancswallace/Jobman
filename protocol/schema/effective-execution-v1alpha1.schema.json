{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobman.tech/schema/protocol/effective-execution-v1alpha1.schema.json",
  "title": "Jobman effective execution v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jobman/v1alpha1"},
    "kind": {"const": "EffectiveExecution"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "runId", "jobId", "namespace"],
      "properties": {
        "executionId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "jobId": {"$ref": "#/$defs/id"},
        "namespace": {"$ref": "workload-v1alpha1.schema.json#/$defs/name"},
        "slurmArray": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collectionId", "taskIndex", "taskCount", "maxParallel"],
          "properties": {
            "collectionId": {"$ref": "#/$defs/id"},
            "taskIndex": {"type": "integer", "minimum": 0, "maximum": 9999},
            "taskCount": {"type": "integer", "minimum": 2, "maximum": 10000},
            "maxParallel": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "placement"],
      "properties": {
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "document"],
          "properties": {
            "digest": {"$ref": "workload-v1alpha1.schema.json#/$defs/digest"},
            "document": {"$ref": "workload-v1alpha1.schema.json"}
          }
        },
        "artifactStores": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"$ref": "workload-v1alpha1.schema.json#/$defs/name"},
              "version": {"type": "integer", "minimum": 1}
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetId", "targetGenerationId", "target", "executionBackend"],
          "properties": {
            "targetId": {"$ref": "#/$defs/id"},
            "targetGenerationId": {"$ref": "#/$defs/id"},
            "target": {"$ref": "workload-v1alpha1.schema.json#/$defs/name"},
            "partition": {"$ref": "workload-v1alpha1.schema.json#/$defs/name"},
            "executionBackend": {"enum": ["subprocess", "slurm"]}
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
