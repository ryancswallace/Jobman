{
  "apiVersion": "jobman/v1alpha1",
  "kind": "Workload",
  "metadata": {},
  "spec": {
    "command": {
      "executable": "true"
    },
    "workingDirectory": "workspace:/",
    "environment": {
      "secrets": [
        {
          "name": "token",
          "source": "secret://research/first",
          "exposeAs": {
            "environment": "FIRST_TOKEN"
          }
        },
        {
          "name": "token",
          "source": "secret://research/second",
          "exposeAs": {
            "environment": "SECOND_TOKEN"
          }
        }
      ]
    },
    "runtime": {
      "kind": "native"
    },
    "policy": {
      "retry": {
        "maxRuns": 1
      },
      "duplicateRisk": "reject"
    }
  }
}
